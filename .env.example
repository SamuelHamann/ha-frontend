# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (see .env*.local in .gitignore) — never commit real credentials.

# Base HTTP URL of your Home Assistant instance (no trailing slash)
EXPO_PUBLIC_HA_URL=http://192.168.2.56:8123

# Home Assistant long-lived access token
# Create one at: Profile > Security > Long-Lived Access Tokens
EXPO_PUBLIC_HA_TOKEN=

# The list of devices the app listens to and displays lives in src/config/devices.ts
# (not secret, so it's git-tracked directly rather than an env var).
